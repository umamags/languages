  "sentences": {
    "general": [
      {
        "native": "நீங்கள் எப்படி இருக்கிறீர்கள்?",
        "en": "How are you?",
        "hi": "आप कैसे हैं?"
      },
      {
        "native": "நான் நன்றாக இருக்கிறேன்",
        "en": "I am fine",
        "hi": "मैं ठीक हूँ"
      },
      {
        "native": "உங்கள் பெயர் என்ன?",
        "en": "What is your name?",
        "hi": "आपका नाम क्या है?"
      },
      {
        "native": "என் பெயர் அரவிந்த்",
        "en": "My name is Arvind",
        "hi": "मेरा नाम अरविंद है"
      },
      {
        "native": "வ안க்கम்",
        "en": "Goodbye",
        "hi": "अलविदा"
      }
    ],
    "shopping": [
      {
        "native": "இதன் விலை என்ன?",
        "en": "What is the price?",
        "hi": "इसकी कीमत क्या है?"
      },
      {
        "native": "இது மிக महंगை",
        "en": "This is very expensive",
        "hi": "यह बहुत महंगा है"
      },
      {
        "native": "தள்ளிக்குக ஏதும் உண்டா?",
        "en": "Do you have any discount?",
        "hi": "क्या आपके पास कोई छूट है?"
      },
      {
        "native": "எனக்கு இதை வாங்க வேண்டும்",
        "en": "I want to buy this",
        "hi": "मुझे यह खरीदना है"
      },
      {
        "native": "நான் பணத்தில் குடுப்பேன்",
        "en": "I will pay cash",
        "hi": "मैं नकद भुगतान करूंगा"
      }
    ],
    "cooking": [
      {
        "native": "இது வெந்து விட்டதா?",
        "en": "Is this cooked?",
        "hi": "क्या यह पका हुआ है?"
      },
      {
        "native": "நீங்கள் மிக நன்றாக요리 செய்கிறீர்கள்",
